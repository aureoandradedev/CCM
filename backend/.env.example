# ============ Multigiro Central de Compras — backend ============
# Copie para backend/.env e preencha. NUNCA versione o .env.

PORTA=4000
# Origens do site autorizadas (CORS). localhost é sempre aceito.
STORE_ORIGINS=https://ccm.multigiroatacadao.com.br

# ---- Supabase (Project Settings > API) ----
SUPABASE_URL=https://xzvgukvmodlrujnnkfbc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ---- Cielo (mesmas credenciais do e-commerce do mercado) ----
CIELO_ENV=production            # production | sandbox
CIELO_MERCHANT_ID=
CIELO_MERCHANT_KEY=
CIELO_PIX_PROVIDER=Cielo
CIELO_SOP_CLIENT_ID=
CIELO_SOP_CLIENT_SECRET=
CIELO_3DS_CLIENT_ID=
CIELO_3DS_CLIENT_SECRET=
CIELO_3DS_ESTABLISHMENT_CODE=
CIELO_3DS_MERCHANT_NAME=Multigiro
CIELO_3DS_MCC=
PIX_EXPIRACAO_SEGUNDOS=3600
PAGAMENTO_LOCK_TTL_MS=120000
# true = simula a Cielo (Pix "paga" sozinho, cartão aprova). Só para desenvolvimento.
PAGAMENTO_MOCK=false
PAGAMENTO_MOCK_PAGO_APOS_SEG=10

# ---- Pedido ----
PEDIDO_HMAC_SECRET=troque-por-32-caracteres-aleatorios-ou-mais
PEDIDO_MAX_QTD_UN=9999
PEDIDO_RATE_MAX=30
PEDIDO_RATE_WINDOW_MS=60000

# ---- QRofertas (fotos de produto; mesmas do motor de encartes) ----
QROFERTAS_EMAIL=
QROFERTAS_PASSWORD=
