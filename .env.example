# Copie para .env.local e preencha com o projeto do Supabase
# (Dashboard > Project Settings > API). Sem essas variáveis o site roda com o
# catálogo mock em src/lib/data/mock.ts.
NEXT_PUBLIC_SUPABASE_URL=https://xzvgukvmodlrujnnkfbc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: chave service_role SÓ para scripts de seed (nunca expor no front).
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Servidor de pedidos/pagamentos/fotos (pasta backend/). Em produção, a URL pública da VPS.
NEXT_PUBLIC_API_BASE=http://localhost:4000/api
